# Copy these into Vercel → Project → Settings → Environment Variables.

# Canonical public URL — non-www, no trailing slash. This is the host every canonical tag,
# sitemap entry, OG tag and OAuth redirect is built from, and www 301s to it. Changing it
# here changes all of them together; changing it in only one place is how they drift apart.
APP_URL=https://trypopulr.in
# Do NOT put real keys in this file — it is committed. Real values go in .env.local (gitignored) or the Vercel dashboard.

# Optional primary — free key from aistudio.google.com/apikey. When set it is tried first,
# with Groq as automatic fallback.
#
# Check which models your key can actually reach before setting this. As of Aug 2026 a new
# free key gets 404 "no longer available to new users" on gemini-2.5-flash and a quota of 0
# on gemini-2.0-flash — i.e. the whole provider is dead weight in front of Groq. List yours:
#
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#     | grep -o '"name": "models/[^"]*"'
#
# Set GEMINI_MODEL to one of those. If none work, leave GEMINI_API_KEY empty and use Groq
# alone — an unreachable provider costs a round-trip on the first request of each deploy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Required (fallback / or use alone) — free key from console.groq.com
GROQ_API_KEY=

# Recommended — lead model. Default is llama-3.3-70b-versatile (most accurate); the app
# auto-falls back to llama-3.1-8b-instant, then llama-4-scout, then compound-mini on rate
# limits/quota so a request never fails. Set to a smaller model to cut quota burn.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional AI-quality tuning:
#   LLM_TEMPERATURE   lower = more grounded/consistent answers + more reliable JSON (default 0.4)
#   MAX_OUTPUT_TOKENS higher = longer deliverables without truncation (default 1024)
LLM_TEMPERATURE=0.4
MAX_OUTPUT_TOKENS=1024

# Intelligence dataset versioning — bump when the recommendation prompt/shape changes
# so recommendation rows stay comparable within a version (see docs/intelligence.md).
PROMPT_VERSION=p1

# Early Access Program
# Admin dashboard access (/early-access/admin) — comma-separated allowlist of signed-in
# emails. Unset = no admins (fail closed).
ADMIN_EMAILS=
# Optional welcome email via Resend (resend.com). Unset = applications still saved,
# email is skipped cleanly.
RESEND_API_KEY=
EARLY_ACCESS_FROM=Populr <team@trypopulr.in>

# (MAX_OUTPUT_TOKENS was declared a second time here with a conflicting 512. Two
# assignments of the same key means the last one silently wins, so the 1024 documented
# above was never what applied. Set it once, above.)

# Optional — caching (needs DATABASE_URL). Repeated analyses of the same site+prompt
# are served from Neon instead of re-calling the LLM, and page scrapes are reused when
# the HTML is unchanged. Defaults shown; all in milliseconds.
ANALYSIS_CACHE_TTL_MS=600000   # 10 min — fresh-hit window for cached AI analyses
ANALYSIS_STALE_MS=86400000     # 24 h — how stale a cached analysis may be when ALL providers fail
SITE_CACHE_TTL_MS=600000       # 10 min — reuse an extracted site summary without re-fetching
# Bump CACHE_VERSION (e.g. v1 → v2) whenever the prompt template changes, so old cached
# analyses are invalidated instead of being served after the change.
CACHE_VERSION=v1

# Optional — OpenAI fallback (used only if no Groq key)
OPENAI_API_KEY=

# Required for cloud persistence AND accounts — Neon Postgres connection string
DATABASE_URL=

# Production schema ownership: run `npm run db:migrate` on deploy, then set this to true so
# the app never issues CREATE/ALTER TABLE at request time (migrations own the schema).
# Leave unset in dev/test — the app auto-creates tables on first use.
SKIP_RUNTIME_DDL=

# Required for accounts — a long random string to sign login sessions
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Optional — Google Search Console integration (real analytics for your own sites)
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Web push notifications ("best time to publish" reminders)
# Generate with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@cosmos.ai
# Protects the reminder cron endpoint (Vercel sets this automatically for its crons)
CRON_SECRET=

# Optional — social login (signing IN to Populr). Google reuses GOOGLE_CLIENT_ID/SECRET
# above. Add the redirect URI  <your-domain>/api/auth/google/callback  in Google Cloud.
# Facebook (Meta Developers app) and X (X Developer app) are optional extras.
# NOTE: only Google is implemented — there is no /api/auth/x or /api/auth/facebook route
# yet, so setting these two makes the buttons appear without a working flow.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL PUBLISHING — posting OUT to platforms (separate from social login above)
# ─────────────────────────────────────────────────────────────────────────────
#
# Leave these empty and nothing changes: every platform uses the reference adapter, which
# records a post and sends nothing. Fill a platform's pair in and that platform starts
# publishing for real. Each is switched on independently.
#
# Required for either platform — the callback base. Must be the exact public origin, no
# trailing slash. The redirect URI registered in the developer app has to match what
# Populr builds from this, character for character, or the provider rejects the exchange:
#   <SOCIAL_REDIRECT_BASE>/api/social/oauth/linkedin/callback
#   <SOCIAL_REDIRECT_BASE>/api/social/oauth/x/callback
SOCIAL_REDIRECT_BASE=https://trypopulr.in

# Encrypts stored account tokens at rest. Required before connecting anything.
# Generate with:  openssl rand -hex 32
SOCIAL_TOKEN_KEY=
# Verifies inbound platform webhooks. Optional until you enable them.
SOCIAL_WEBHOOK_SECRET=

# --- LinkedIn -----------------------------------------------------------------
# developer.linkedin.com → create an app → Products: request "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect". Both are needed: the first grants
# w_member_social (posting), the second identifies which member to post as.
# Scopes requested: openid, profile, w_member_social
# Posts as the signed-in member. Text and links only — image/video upload is not built yet.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X (Twitter) --------------------------------------------------------------
# developer.x.com → Project → App → User authentication settings:
#   Type of App: "Web App" (confidential client, required for the token exchange)
#   App permissions: "Read and write"
# Scopes requested: tweet.read, tweet.write, users.read, offline.access
#
# Deliberately NOT named X_CLIENT_ID — that one is used by "sign in with X" above. If
# publishing shared it, configuring login would silently switch publishing to live using
# login scopes that cannot post, and every post would fail with 403. The same X app can
# supply the same values to both; keeping the names apart makes that a decision.
#
# Heads up on cost: v2 write access needs a paid tier. On a free project the post call
# returns 403 and Populr reports it as such rather than pretending it worked.
X_PUBLISH_CLIENT_ID=
X_PUBLISH_CLIENT_SECRET=

# Not implemented yet — Instagram, Facebook Pages, Threads and Pinterest stay on the
# reference adapter no matter what is set. Instagram in particular needs a Business
# account plus Facebook app review before it can post at all.

# ─────────────────────────────────────────────────────────────────────────────
# BILLING (Polar)
# ─────────────────────────────────────────────────────────────────────────────
#
# Leave these empty and nothing changes: access falls back to the local 30-day trial and
# nobody can subscribe. Fill them in and paid subscriptions start granting access.
#
# The webhook secret is the important one — /api/webhooks/polar grants paid access, so an
# unverified endpoint is a public "make me a customer" button. With no secret set, every
# webhook is rejected rather than trusted.
POLAR_WEBHOOK_SECRET=

# Server-side token for creating checkouts. Never NEXT_PUBLIC_.
POLAR_ACCESS_TOKEN=

# The product being sold. From the Polar product page URL.
POLAR_PRODUCT_ID=

# "sandbox" while testing, "production" when live. Polar runs them as separate environments
# with separate tokens — a sandbox token against production silently sells nothing.
POLAR_ENV=sandbox
